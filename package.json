{
  "name": "atlas-commerce",
  "version": "0.0.0",
  "private": true,
  "description": "Bootstrap técnico do monorepo Atlas Commerce.",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "12.11.2"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @atlas/storefront --filter @atlas/admin --filter @atlas/api dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint apps packages --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "smoke": "pnpm --filter @atlas/api smoke",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm smoke && pnpm format:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
