digraph UX03 {
 graph [rankdir=TB, bgcolor="white", label="UX-03 | Stripe Checkout incorporado (Test Mode) | Proposta a validar", labelloc=t, fontsize=19, fontname="DejaVu Sans", pad="0.35", ranksep="0.45", nodesep="0.32"];
 node [shape=box, style="rounded,filled", fillcolor="#eef3f0", color="#8ba69b", fontname="DejaVu Sans", fontsize=10, margin="0.14,0.11"];
 edge [color="#738c80", fontname="DejaVu Sans", fontsize=9];
 cart [label="Carrinho\nSem reserva"]; login [shape=diamond, label="Conta válida?", fillcolor="#f9ecd9"]; auth [label="Entrar / criar / recovery\nPreservar intenção"]; quote [label="Servidor: cotação e elegibilidade\nPreço, cupom e estoque"]; viable [shape=diamond, label="Elegível?", fillcolor="#f9ecd9"]; adjust [label="Rever carrinho\nSem efeitos financeiros", fillcolor="#fdecea"];
 tx [label="Transação PG\nPedido + snapshot + outbox\nReserva 40min SOMENTE físico"]; session [label="Stripe Checkout Session\nTest Mode; embedded por versão\n30min propostos; se físico buffer >=5min"]; gate [shape=diamond,label="Sessão válida?",fillcolor="#f9ecd9"]; pending [label="Intenção segura\nPendente / reconciliação\nNão montar formulário",fillcolor="#fdecea"];
 form [label="P47: formulário Stripe incorporado\nna página Atlas\nClient secret de sessão protegido",fillcolor="#d7ece1",penwidth=2]; side [label="PSP / 3DS se necessário\nPode exigir redirect bancário"]; return [label="P48: acompanhar estado\nComponente / retorno não confirma pagamento"]; verify [label="NestJS valida PSP\nWebhook assinado, ordem/valor/moeda\nIdempotência + estado DB"]; paid [shape=diamond,label="Quitação + elegibilidade?",fillcolor="#f9ecd9"]; success [label="Confirmar pedido, liberar conforme regras\nEntitlement condicionado ao kit",fillcolor="#d7ece1"]; review [label="PENDENTE / PAYMENT_REVIEW\nRefund idempotente se tardio\nSem fulfillment antecipado",fillcolor="#fdecea"];
 cart->login;login->auth [label="não"];auth->login;login->quote [label="sim"];quote->viable;viable->adjust [label="não"];viable->tx [label="sim"];tx->session;session->gate;gate->pending [label="não"];gate->form [label="sim"];form->side [style=dashed,label="quando aplicável"];form->return;side->return;form->verify [label="evento PSP"];return->verify [style=dashed,label="consulta estado"];verify->paid;paid->success [label="sim"];paid->review [label="não/incerto"];
}
