		catalog [label="Consultar catálogo" color="#93c5fd" fillcolor="#eff6ff" shape=ellipse]
		search [label="Pesquisar e filtrar" color="#93c5fd" fillcolor="#eff6ff" shape=ellipse]
		preview [label="Visualizar prévia" color="#93c5fd" fillcolor="#eff6ff" shape=ellipse]
		cart [label="Gerenciar carrinho" color="#93c5fd" fillcolor="#eff6ff" shape=ellipse]
		login [label="Autenticar-se" color="#93c5fd" fillcolor="#eff6ff" shape=ellipse]
		checkout [label="Confirmar checkout" color="#93c5fd" fillcolor="#eff6ff" shape=ellipse]
		orders [label="Consultar meus pedidos" color="#93c5fd" fillcolor="#eff6ff" shape=ellipse]
		address [label="Gerenciar endereços" color="#93c5fd" fillcolor="#eff6ff" shape=ellipse]
		library [label="Acessar biblioteca digital" color="#93c5fd" fillcolor="#eff6ff" shape=ellipse]
		request [label="Solicitar cancelamento
ou devolução" color="#93c5fd" fillcolor="#eff6ff" shape=ellipse]
	}
	visitor -> catalog [arrowhead=none color="#64748b"]
