digraph AtlasCommerce {
	graph [bgcolor=white concentrate=false fontcolor="#0f172a" fontname="DejaVu Sans" fontsize=23 label="SM-06 • Solicitação de devolução" labelloc=t nodesep=.52 outputorder=edgesfirst pad=0.24 rankdir=LR ranksep=.87 splines=polyline]
	node [color="#cbd5e1" fillcolor="#f8fafc" fontcolor="#0f172a" fontname="DejaVu Sans" fontsize=11 margin="0.14,0.09" penwidth=1.3 shape=box style="rounded,filled"]
	edge [arrowsize=.7 color="#475569" fontcolor="#64748b" fontname="DejaVu Sans" fontsize=10]
	request [label=REQUESTED color="#1d4ed8" fillcolor="#eff6ff"]
	review [label=UNDER_REVIEW color="#1d4ed8" fillcolor="#eff6ff"]
	approved [label=APPROVED color="#0f766e" fillcolor="#f0fdfa"]
	rejected [label=REJECTED color="#b91c1c" fillcolor="#fef2f2" fontcolor="#991b1b"]
	completed [label=COMPLETED color="#0f172a" fillcolor="#e2e8f0" shape=box]
	request -> review [label="Triagem registrada"]
	review -> approved [label="Política e evidências
