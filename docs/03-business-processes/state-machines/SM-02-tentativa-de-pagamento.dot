digraph AtlasCommerce {
graph [bgcolor=white fontname="DejaVu Sans" fontcolor="#0f172a" fontsize=22 label="SM-02 • Tentativa de pagamento" labelloc=t pad="0.34" rankdir=TB ranksep="0.83" nodesep="0.45" splines=polyline outputorder=edgesfirst];
node [fontname="DejaVu Sans" fontsize=11 color="#cbd5e1" fillcolor="#f8fafc" fontcolor="#0f172a" style="rounded,filled" shape=box margin="0.16,0.12" penwidth=1.2];
edge [fontname="DejaVu Sans" fontsize=10 color="#475569" fontcolor="#475569" arrowsize=.7];

created [label="CREATED" color="#1d4ed8" fillcolor="#eff6ff"];
pending [label="PENDING" color="#1d4ed8" fillcolor="#eff6ff"];
approved [label="APPROVED" color="#0f766e" fillcolor="#f0fdfa"];
failed [label="FAILED" color="#b91c1c" fillcolor="#fef2f2"];
cancel [label="CANCELLED" color="#64748b" fillcolor="#e2e8f0"];
created -> pending [label="Tentativa criada no PSP"];
created -> failed [label="Falha comprovada na criação"];
pending -> approved [label="Pagamento comprovado\ne valor/moeda validados"];
pending -> failed [label="Recusa definitiva comprovada"];
pending -> cancel [label="Cancelamento externo confirmado"];
note [shape=note label="Timeout não prova falha. Reembolso é entidade separada (SM-07).\nRepetições e eventos fora de ordem não regridem estado." color="#f59e0b" fillcolor="#fffbeb"];
note -> pending [style=invis];

}
