digraph AtlasCommerce {
graph [bgcolor=white fontname="DejaVu Sans" fontcolor="#0f172a" fontsize=22 label="SM-01 • Pedido | Estados comerciais" labelloc=t pad="0.34" rankdir=TB ranksep="0.83" nodesep="0.45" splines=polyline outputorder=edgesfirst];
node [fontname="DejaVu Sans" fontsize=11 color="#cbd5e1" fillcolor="#f8fafc" fontcolor="#0f172a" style="rounded,filled" shape=box margin="0.16,0.12" penwidth=1.2];
edge [fontname="DejaVu Sans" fontsize=10 color="#475569" fontcolor="#475569" arrowsize=.7];

pend [label="PENDING_PAYMENT" color="#1d4ed8" fillcolor="#eff6ff"];
paid [label="PAID" color="#0f766e" fillcolor="#f0fdfa"];
review [label="PAYMENT_REVIEW" color="#b45309" fillcolor="#fff7ed"];
cancel [label="CANCELLED" color="#64748b" fillcolor="#e2e8f0"];
fulfilling [label="IN_FULFILLMENT" color="#1d4ed8" fillcolor="#eff6ff"];
partial [label="PARTIALLY_FULFILLED" color="#1d4ed8" fillcolor="#eff6ff"];
done [label="FULFILLED" color="#0f766e" fillcolor="#f0fdfa"];
pend -> paid [label="Cobrança válida;\nreserva confirmada / só digital"];
pend -> review [label="Pago após reserva liberada\nou situação financeira incerta"];
pend -> cancel [label="Sem pagamento;\nencerramento externo comprovado"];
review -> cancel [label="Reembolso integral concluído\nou não cobrança comprovada"];
paid -> fulfilling [label="Iniciar fulfillment"];
fulfilling -> partial [label="Parte dos itens concluída"];
fulfilling -> done [label="Tudo concluído"];
partial -> done [label="Demais itens concluídos"];
note [label="Após fulfillment, devolução/reembolso é caso de pós-venda separado;\nnão regredir pedido a CANCELLED." shape=note color="#f59e0b" fillcolor="#fffbeb"];
note -> review [style=invis];

}
