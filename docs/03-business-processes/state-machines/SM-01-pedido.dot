digraph AtlasCommerce {
	graph [bgcolor=white concentrate=false fontcolor="#0f172a" fontname="DejaVu Sans" fontsize=23 label="SM-01 • Ciclo de vida do pedido" labelloc=t nodesep=.52 outputorder=edgesfirst pad=0.24 rankdir=TB ranksep=.87 splines=polyline]
	node [color="#cbd5e1" fillcolor="#f8fafc" fontcolor="#0f172a" fontname="DejaVu Sans" fontsize=11 margin="0.14,0.09" penwidth=1.3 shape=box style="rounded,filled"]
	edge [arrowsize=.7 color="#475569" fontcolor="#64748b" fontname="DejaVu Sans" fontsize=10]
	new [label=PENDING_PAYMENT color="#1d4ed8" fillcolor="#eff6ff"]
	paid [label=PAID color="#0f766e" fillcolor="#f0fdfa"]
	review [label=PAYMENT_REVIEW color="#b91c1c" fillcolor="#fef2f2" fontcolor="#991b1b"]
	cancel [label=CANCELLED color="#0f172a" fillcolor="#e2e8f0" shape=box]
	doing [label=IN_FULFILLMENT color="#1d4ed8" fillcolor="#eff6ff"]
	partial [label=PARTIALLY_FULFILLED color="#1d4ed8" fillcolor="#eff6ff"]
	done [label=FULFILLED color="#0f172a" fillcolor="#e2e8f0" shape=box]
	new -> paid [label="Pagamento validado +
alocação íntegra"]
	new -> review [label="Pagamento tardio ou
divergência"]
	new -> cancel [label="Sem pagamento + encerramento
seguro"]
	review -> paid [label="Conciliação + alocação
aprovadas"]
	review -> cancel [label="Compensação concluída"]
	paid -> doing [label="Iniciar fulfillment"]
	paid -> cancel [label="Cancelamento pago +
compensação"]
	doing -> partial [label="Itens concluídos
parcialmente"]
	doing -> done [label="Todos os itens concluídos"]
	partial -> done [label="Restantes concluídos"]
	NOTE [label="Não confundir estado do pedido com pagamento, remessa ou devolução." color="#fcd34d" fillcolor="#fffbeb" fontsize=10 shape=note]
	NOTE -> new [style=invis]
}
