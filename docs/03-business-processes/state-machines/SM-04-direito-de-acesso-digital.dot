digraph AtlasCommerce {
	graph [bgcolor=white concentrate=false fontcolor="#0f172a" fontname="DejaVu Sans" fontsize=23 label="SM-04 • Direito de acesso digital" labelloc=t nodesep=.52 outputorder=edgesfirst pad=0.24 rankdir=LR ranksep=.87 splines=polyline]
	node [color="#cbd5e1" fillcolor="#f8fafc" fontcolor="#0f172a" fontname="DejaVu Sans" fontsize=11 margin="0.14,0.09" penwidth=1.3 shape=box style="rounded,filled"]
	edge [arrowsize=.7 color="#475569" fontcolor="#64748b" fontname="DejaVu Sans" fontsize=10]
	active [label=ACTIVE color="#0f766e" fillcolor="#f0fdfa"]
	suspended [label=SUSPENDED color="#1d4ed8" fillcolor="#eff6ff"]
	revoked [label=REVOKED color="#0f172a" fillcolor="#e2e8f0" shape=box]
	active -> suspended [label="Suspensão justificada e
registrada"]
	suspended -> active [label="Reativação autorizada"]
	active -> revoked [label="Revogação autorizada e
auditada"]
	suspended -> revoked [label="Revogação definitiva
autorizada"]
	NOTE [label="Criação ACTIVE somente com quitação validada + elegibilidade." color="#fcd34d" fillcolor="#fffbeb" fontsize=10 shape=note]
	NOTE -> active [style=invis]
}
