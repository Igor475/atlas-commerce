        <dc:Bounds x="2050" y="756" width="46" height="46"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_01" bpmnElement="Flow_01">
        <di:waypoint x="89" y="177"/>
        <di:waypoint x="130" y="178"/>
      </bpmndi:BPMNEdge>
