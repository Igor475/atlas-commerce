<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_CompraFisica" targetNamespace="https://atlas-commerce.example/docs/processos">
  <bpmn:process id="Process_CompraFisica" name="BPMN-01 — Compra física e pagamento — modelo descritivo" isExecutable="false">
    <bpmn:startEvent id="start" name="Início">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="cart" name="Selecionar itens físicos">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="quote" name="Calcular cotação no servidor">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="approve" name="Confirmar valores">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="reserve" name="Criar pedido + reserva 40m na transação">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="stock" name="Reserva OK?">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="pay" name="Pagamentos: sessão com prazo válido">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="compatible" name="PSP válido?">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="verify" name="Pagamentos: autenticar / conciliar evento">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="result" name="Resultado?">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="confirm" name="Confirmar reserva ativa e pedido PAID">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="fulfill" name="Fulfillment autorizado">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endok" name="Preparação">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="reject" name="Informar indisponibilidade">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="endno" name="Sem compra">
      <bpmn:incoming>Flow_08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="pspbad" name="Não expor sessão / compensar">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endbad" name="Sessão inválida">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="review" name="PAYMENT_REVIEW + bloquear entrega">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="refund" name="Refund integral idempotente">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endreview" name="Reconciliar refund">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="uncertain" name="Indeterminado: conciliar; não liberar">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endwait" name="Revisão">
      <bpmn:incoming>Flow_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="close" name="Sem cobrança final: liberar / cancelar">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endclosed" name="Cancelado">
      <bpmn:incoming>Flow_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="start" targetRef="cart"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="cart" targetRef="quote"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="quote" targetRef="approve"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="approve" targetRef="reserve"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="reserve" targetRef="stock"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="stock" targetRef="pay" name="Sim"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="stock" targetRef="reject" name="Não"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="reject" targetRef="endno"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="pay" targetRef="compatible"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="compatible" targetRef="verify" name="Sim"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="compatible" targetRef="pspbad" name="Não"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="pspbad" targetRef="endbad"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="verify" targetRef="result"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="result" targetRef="confirm" name="Pago / reserva ACTIVE"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="confirm" targetRef="fulfill"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="fulfill" targetRef="endok"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="result" targetRef="review" name="Pago / reserva expirada"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="review" targetRef="refund"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="refund" targetRef="endreview"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="result" targetRef="uncertain" name="Incerteza"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="uncertain" targetRef="endwait"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="result" targetRef="close" name="Recusa final"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="close" targetRef="endclosed"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_CompraFisica">
    <bpmndi:BPMNPlane id="Plane_CompraFisica" bpmnElement="Process_CompraFisica">
      <bpmndi:BPMNShape id="Shape_start" bpmnElement="start">
        <dc:Bounds x="45" y="155" width="44" height="44"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_cart" bpmnElement="cart">
        <dc:Bounds x="130" y="137" width="175" height="82"/>
      </bpmndi:BPMNShape>
