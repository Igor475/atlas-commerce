        <dc:Bounds x="2180" y="563" width="46" height="46"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_close" bpmnElement="close">
        <dc:Bounds x="1760" y="742" width="230" height="75"/>
      </bpmndi:BPMNShape>
