        <dc:Bounds x="1505" y="335" width="205" height="76"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_endbad" bpmnElement="endbad">
        <dc:Bounds x="1770" y="348" width="45" height="45"/>
      </bpmndi:BPMNShape>
