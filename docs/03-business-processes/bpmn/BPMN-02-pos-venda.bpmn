<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PosVenda" targetNamespace="https://atlas-commerce.example/docs/processos">
  <bpmn:process id="Process_PosVenda" name="BPMN-02 — Pós-venda e reembolso — modelo descritivo" isExecutable="false">
    <bpmn:startEvent id="start" name="Início">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="receive" name="Registrar solicitação inclusive digital">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="legal" name="Analisar direito e natureza do pedido">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gateway" name="Elegível?">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="authorize" name="Autorizar alçada / segregação">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="calculate" name="Snapshot e saldo disponível">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="reserve" name="Reservar refund no banco">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="submit" name="Enviar refund idempotente ao PSP">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="reconcile" name="Conciliar resposta do PSP">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="state" name="Estado?">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="success" name="Registrar refund SUCCEEDED">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="inspect" name="Inspecionar devolução física">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="digital" name="Revisar direitos digitais (sem auto revogar)">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="done" name="Concluído">
      <bpmn:incoming>Flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="exception" name="Revisão humana/CDC - registrar justificativa">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="decision" name="Deferir?">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="denied" name="Decisão fundamentada">
      <bpmn:incoming>Flow_08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="unknown" name="Resposta ambígua: manter saldo reservado">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="pending" name="Aguardar reconciliação">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="failed" name="Falha definitiva: liberar reserva financeira">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endfailed" name="Falha tratada">
      <bpmn:incoming>Flow_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="start" targetRef="receive"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="receive" targetRef="legal"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="legal" targetRef="gateway"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="gateway" targetRef="authorize" name="Sim"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="gateway" targetRef="exception" name="Revisar / exceção"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="exception" targetRef="decision"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="decision" targetRef="authorize" name="Autorizar"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="decision" targetRef="denied" name="Indeferir cabível"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="authorize" targetRef="calculate"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="calculate" targetRef="reserve"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="reserve" targetRef="submit"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="submit" targetRef="reconcile"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="reconcile" targetRef="state"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="state" targetRef="success" name="Confirmado"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="success" targetRef="inspect"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="inspect" targetRef="digital"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="digital" targetRef="done"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="state" targetRef="unknown" name="Incerto"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="unknown" targetRef="pending"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="state" targetRef="failed" name="Falha definitiva"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="failed" targetRef="endfailed"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_PosVenda">
    <bpmndi:BPMNPlane id="Plane_PosVenda" bpmnElement="Process_PosVenda">
