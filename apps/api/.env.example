# Configuração local não secreta.
PORT=3002

# F04-05: disabled by default. Never reuse ambient DATABASE_URL or SPIKE_* for cloud.
PERSISTENCE_ENABLED=false
PERSISTENCE_PROFILE=disabled
PERSISTENCE_POOL_MAX=2
# Local test opt-in only, set by connection:test; no credentials.
PERSISTENCE_LOCAL_DISPOSABLE=
# Future L1 preparation only: values supplied through a secure channel after project authorization.
# Enabling cloud in the HTTP API is blocked in this stage.
PERSISTENCE_PROBE_URL=
PERSISTENCE_ENDPOINT_SOURCE=
PERSISTENCE_TRANSPORT=
PERSISTENCE_IPV6_VERIFIED=
PERSISTENCE_EXPECTED_HOST=
PERSISTENCE_EXPECTED_ROLE=
PERSISTENCE_TEST_PROJECT=
PERSISTENCE_TLS=
PERSISTENCE_CA_FILE=
# Runtime (business grants), migration (DDL) and diagnostic readonly are separate identities.
# No cloud migrator, SDK, URL, password, token or private CA/key is provided here.

# ID-01: public/demo auth remains closed. No real mail adapter is enabled here.
IDENTITY_PROFILE=disabled
IDENTITY_DISPOSABLE=
IDENTITY_ORIGIN=http://127.0.0.1:3002
# Ephemeral local/CI key supplied only by the test process; never commit a value.
IDENTITY_SECRET=
IDENTITY_ABSOLUTE_SECONDS=43200
IDENTITY_IDLE_SECONDS=1800
IDENTITY_VERIFY_SECONDS=1800
IDENTITY_RECOVERY_SECONDS=900
IDENTITY_IP_LIMIT=60
IDENTITY_ACCOUNT_LIMIT=10
IDENTITY_ARGON_MEMORY=19456
IDENTITY_ARGON_PASSES=2
