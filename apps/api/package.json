{
  "name": "@atlas/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "pnpm spike:generate && pnpm identity:generate && nest build",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm spike:generate && pnpm identity:generate && tsc -p tsconfig.json --noEmit",
    "test": "pnpm spike:generate && pnpm identity:generate && vitest run",
    "smoke": "pnpm build && node scripts/smoke.mjs",
    "spike:generate": "prisma generate",
    "spike:validate": "prisma validate",
    "spike:migrate": "node scripts/spike-db.mjs migrate",
    "spike:test": "pnpm build && node scripts/spike-db.mjs test",
    "spike:diff": "node scripts/spike-db.mjs diff",
    "connection:test": "pnpm build && node scripts/connection-local.mjs",
    "identity:generate": "prisma generate --config identity.prisma.config.ts",
    "identity:migrate": "node scripts/identity-db.mjs migrate",
    "identity:test": "pnpm build && node scripts/identity-db.mjs test"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "8.23.1",
    "@prisma/client-runtime-utils": "7.10.0"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.3",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "prisma": "7.10.0",
    "@types/pg": "8.23.1"
  }
}
